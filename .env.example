# Environment Configuration Template
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL Database (Supports Postgres 16 + pgvector)
# Example local or cloud URL (Supabase, Neon, AWS RDS, Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatbot_saas?schema=public"

# Redis (Caching, Queues & Distributed Locks)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-jwt-signing-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
# 32-byte hex key for encrypting third-party API credentials at rest
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Core AI LLM Providers
OPENAI_API_KEY="sk-proj-your-openai-api-key"
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"

# Meta WhatsApp Cloud API (Global fallback credentials)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_WEBHOOK_VERIFY_TOKEN="your_webhook_verification_token"

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Cloudflare R2 / AWS S3 File Storage (Document RAG & Media)
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your_access_key_id"
S3_SECRET_ACCESS_KEY="your_secret_access_key"
S3_BUCKET_NAME="chatbot-knowledge-assets"
S3_PUBLIC_DOMAIN="https://assets.yourdomain.com"
