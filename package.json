{
  "name": "omnichannel-ai-chatbot-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade multi-tenant AI WhatsApp & Omnichannel Chatbot SaaS platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/api",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web-dashboard",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:migrate": "npm run db:migrate --workspace=packages/database",
    "db:seed": "npm run db:seed --workspace=packages/database"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "typescript": "^5.4.5"
  }
}
